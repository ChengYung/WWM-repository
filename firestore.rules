rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Profiles - Allow users to view/create their profile, but restrict plan / limits to admin only
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "secert811116@gmail.com");
      
      allow create: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.get('plan', 'free') == 'free' &&
        request.resource.data.get('maxProjects', 1) == 1
      );
      
      allow update: if request.auth != null && (
        request.auth.token.email == "secert811116@gmail.com" || (
          request.auth.uid == userId && 
          request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free') &&
          request.resource.data.get('maxProjects', 1) == resource.data.get('maxProjects', 1)
        )
      );
      
      allow delete: if request.auth != null && request.auth.token.email == "secert811116@gmail.com";
    }

    // 2. Projects & Players
    match /projects/{projectId} {
      // Public Read
      allow read: if true;
      
      // Project Creation - Logged in only
      allow create: if request.auth != null && 
                      request.resource.data.ownerId == request.auth.uid &&
                      request.resource.data.get('isPremium', false) == false &&
                      request.resource.data.get('isRestricted', false) == false;
      
      // Project Updates
      allow update: if (
        // A. Owner/Admin can change configuration (Owner can ALWAYS update to manage lock)
        (
          request.auth != null && 
          (resource.data.ownerId == request.auth.uid || request.auth.token.email == "secert811116@gmail.com") &&
          (
            request.auth.token.email == "secert811116@gmail.com" || (
              request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false) &&
              request.resource.data.get('isRestricted', false) == resource.data.get('isRestricted', false) &&
              request.resource.data.get('expirationDate', 0) == resource.data.get('expirationDate', 0) &&
              request.resource.data.get('restrictionMessage', '') == resource.data.get('restrictionMessage', '')
            )
          )
        ) ||
        
        // B. Public Coordination: Everyone can update playerCount IF not restricted
        (
          resource.data.get('isRestricted', false) == false && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount'])
        )
      );

      // Project Deletion
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || request.auth.token.email == "secert811116@gmail.com");

      // Players Coordination - UNRESTRICTED ACCESS FOR COORDINATION
      match /players/{playerId} {
        allow read: if true;
        
        // Coordination functions: Add/Edit/Delete
        // Only fails if the parent project is manually restricted
        allow write: if get(/databases/$(database)/documents/projects/$(projectId)).data.get('isRestricted', false) == false ||
                        (request.auth != null && request.auth.token.email == "secert811116@gmail.com");
      }

      // Members Coordination
      match /members/{memberId} {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/projects/$(projectId)).data.get('isRestricted', false) == false ||
                        (request.auth != null && request.auth.token.email == "secert811116@gmail.com");
      }
    }
  }
}
